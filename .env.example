# PFM Ingestion BFF Go — Local Profile Example (Run ../init-local-development.sh to generate .env.local)
APP_ENV=local
SERVER_PORT=8080
PORT=8080
KAFKA_BROKERS=localhost:9092
AWS_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_ENDPOINT=http://localhost:4566
CORE_LEDGER_GRPC_ADDR=localhost:9090
CORE_LEDGER_HTTP_URL=http://localhost:8082
FORECAST_GRPC_ADDR=localhost:9091
FORECAST_ENGINE_HTTP_URL=http://localhost:9091
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:18081
# Datadog Unified Service Tagging & OpenTelemetry (Plug-and-Play ADR-010)
DD_SERVICE=pfm-ingestion-bff-go
DD_ENV=local
DD_VERSION=0.1.0-local
DD_LOGS_INJECTION=true
DD_TRACE_SAMPLE_RATE=1.0
DD_SITE=us3.datadoghq.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CLOUDWATCH_LOGS_ENABLED=false
DD_API_KEY=
