X-Tenant-ID: {{tenantA}}
Content-Type: application/json

{
  "contract_id": "fin-imob-sac-2026",
  "amortization_system": "SAC",
  "prepayment_strategy": "REDUCE_TERM",
  "outstanding_balance": "320000.00",
  "annual_interest_rate": "9.49",
  "remaining_installments": 240,
  "extra_amortization_amount": "50000.00"
}

